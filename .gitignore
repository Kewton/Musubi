# Local credentials and agent session data
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.commandcode/
.DS_Store

# Terraform state and credentials; keep .terraform.lock.hcl tracked
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.state-backups/

# Build artifacts / toolchain
node_modules/
.turbo/
dist/
.output/
.wrangler/
*.tsbuildinfo

# 非公開リポジトリ Kewton/Musubi-workspace へ分離した文書（→ workspace/mvp/m0/00b-decisions.md D-2）
# 再び置かれても公開リポジトリへ入らないようにする
workspace/proposal/
workspace/legal/
workspace/naming/

# CommandMate のスキル（.claude/skills, .agents/skills）は **追跡する**。
# git worktree で並列開発するとき、worktree には tracked なファイルしか複製されない。
# ignore するとワークツリー側でスキルが見つからず、cmate-* の手順が使えなくなる。
# 機械ごとに変わるローカル設定だけを除外する。
.claude/settings.local.json

# cmate-orchestrate の run artifact（plan / dispatch report / 生成された実行契約）。
# run ごとに生まれる作業記録で、再現に要らない。verify.yaml・profiles・scripts は追跡する。
.commandmate/orchestrate/
.commandmate/tasks/cmate-orchestrate-issue-*.yaml
