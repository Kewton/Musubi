{
  // Community Gateway。**D1 / R2 / DO を直接触らない**（CLAUDE.md 不変条件）。
  //   持つ binding は data-api への Service Binding（DATA_API）だけ。data-api は外部ルートを持たないので、
  //   D1 / R2 / DO へはこの1本を経由してしか届かない（03 §1）。
  //
  // ── infra:sync の同期先である（正本：infra/scripts/sync-bindings.ts 冒頭）──────────
  //   - env.dev / env.staging / env.production の3ブロックを必ず置く。deploy は必ず --env を付ける
  //   - **Terraform 由来の binding を持たない。** d1_databases / r2_buckets / queues / kv_namespaces /
  //     dispatch_namespaces を書かない（不変条件違反であり、infra:sync も対応しない binding として失敗させる）
  //   - services は Terraform の管理外（wrangler 側）なので infra:sync は触らない
  //   - Account ID を書かない（public リポジトリ）
  //   この契約は infra/scripts/sync-bindings.test.ts が、DO を含む binding の不在と services の宛先は src/index.test.ts が確かめる。
  //
  // ── /healthz の詳細を誰に返すか（03 §5「セキュリティ上の注意」）────────────────
  //   vars.HEALTHZ_DETAIL … "public"（dev / staging）は誰にでも詳細を返す。"probe"（production）は X-Musubi-Probe ヘッダが
  //                         secret MUSUBI_PROBE_TOKEN と一致したときだけ返し、それ以外は {"ok": true|false} だけにする。
  //                         未設定・書き違いは probe として扱う（閉じる側に倒す）
  //   MUSUBI_PROBE_TOKEN  … **Worker の secret。ここ（vars）に書かない。** 値の正本は GitHub の production 環境の Secret MUSUBI_PROBE_TOKEN で、
  //                         CD（deploy-production.yml。04 §5）が deploy のたびに `wrangler deploy --secrets-file` で gateway と host に同じ値を載せる
  //                         （infra/scripts/deploy-worker.ts。値が無ければ配らない）。**手で wrangler secret put をしない**（次の deploy で上書きされる）。
  //                         host はこの値を X-Musubi-Probe に載せて gateway の詳細を受け取る。置いていない production は常に隠す
  //   この値の env ごとの形と、secret が vars に無いことは src/index.test.ts が確かめる。
  //
  // ⚠️ services / vars は env へ継承されない。だから3環境に丸ごと書く（data-api と同じ）。
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "musubi-dev-gateway",
  "main": "src/index.ts",

  // data-api / app-do と揃える（同梱 workerd 1.20260911.1 が受け付ける最大値。2026-09-14 着手時点）。
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },

  // apps/* はインターネットから届く Worker（CLAUDE.md）。ドメインが無い間は workers.dev で受ける
  // （00 H-04。ゾーンを委任したら routes を足す）。data-api とは逆に、ここは到達経路を持つ。
  "workers_dev": true,

  "env": {
    "dev": {
      "name": "musubi-dev-gateway",
      "vars": { "ENVIRONMENT": "dev", "GIT_SHA": "local", "HEALTHZ_DETAIL": "public" },
      // service は data-api の wrangler.jsonc の env.<env>.name。**同じ env の data-api に結ぶ**
      "services": [{ "binding": "DATA_API", "service": "musubi-dev-data-api" }]
    },
    "staging": {
      "name": "musubi-staging-gateway",
      "vars": { "ENVIRONMENT": "staging", "GIT_SHA": "local", "HEALTHZ_DETAIL": "public" },
      "services": [{ "binding": "DATA_API", "service": "musubi-staging-data-api" }]
    },
    "production": {
      "name": "musubi-production-gateway",
      "vars": { "ENVIRONMENT": "production", "GIT_SHA": "local", "HEALTHZ_DETAIL": "probe" },
      "services": [{ "binding": "DATA_API", "service": "musubi-production-data-api" }]
    }
  }
}
