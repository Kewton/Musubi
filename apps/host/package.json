{
  "name": "@musubi/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA Host Shell。SPAシェル配信（Free の CPU 10ms 制約により SSR にしない）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@musubi/sdk": "workspace:*"
  }
}
