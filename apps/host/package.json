{
  "name": "@musubi/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA Host Shell。SPAシェル配信（Free の CPU 10ms 制約により SSR にしない）",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.app.json --pretty",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@musubi/sdk": "workspace:*",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.53",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
