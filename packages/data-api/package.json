{
  "name": "@musunest/data-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "★唯一の権限強制点（Worker）。外部ルートを持たない",
  "main": "./dist/contract.js",
  "types": "./dist/contract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@musunest/appspec-schema": "workspace:*",
    "@musunest/sdk": "workspace:*",
    "@musunest/spec-engine": "workspace:*",
    "@musunest/app-do": "workspace:*"
  }
}
